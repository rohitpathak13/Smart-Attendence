# Exclude VCS
.git/
.gitignore
.gitattributes

# Exclude development artifacts
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Exclude sensitive data - NEVER in container image
Attendance/
*.csv
psd.txt
psd.txt.lnk
data/*.db
data/*.db-shm
data/*.db-wal
exports/
*.env
.env

# Exclude IDE files
.vscode/
.idea/
*.swp

# Exclude docs that inflate image size
*.md
!README.md

# Exclude tests (not needed in production container)
test_*.py

# Exclude local logs
*.log

# Windows system files
Thumbs.db
desktop.ini
