# ==============================================================================
# DeepVision AI - Environment Configuration Example
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0

# Persistent Storage Paths (Set to your Railway Volume Mount Path, e.g. /app/data)
DATA_DIR=/app/data
MODELS_DIR=/app/models
EXPORTS_DIR=/app/exports

# Specific DB Path (optional override)
# DB_PATH=/app/data/attendance_system.db

# Attendance Rules & Thresholds
CONFIDENCE_THRESHOLD=0.60
NMS_THRESHOLD=0.3
COSINE_SIMILARITY_THRESHOLD=0.363
L2_DISTANCE_THRESHOLD=1.128

# Duplicate mark cooldown in minutes
COOLDOWN_MINUTES=5

# Late cutoff time (HH:MM:SS)
LATE_CUTOFF_TIME=09:15:00

# Security Credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123
SECRET_KEY=change-this-to-a-strong-random-key-in-production
